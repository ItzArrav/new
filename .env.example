# Copy this file to .env and fill it in. Never commit .env (it is in .gitignore).

# Login-token signing secret: at least 32 characters. The server refuses to start with this placeholder.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_MINUTES=60

# LLM providers: tried in this order; providers without a key are skipped. Fill in at least one key.
# Or store a key from a hidden prompt: python -m scripts.set_key openai|anthropic|openrouter
LLM_PROVIDER=openai,anthropic,openrouter
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENROUTER_MODEL=openai/gpt-4o-mini

# Password for the demo users (admin, alice, bob, carol) created by: python -m app.seed
SEED_PASSWORD=demo-pass-123

# Storage
DATABASE_URL=sqlite:///./data/app.db
USAGE_JSONL_PATH=./data/raw_usage.jsonl

# Agent behaviour and cost controls (0 = unlimited)
SENTIMENT_VOTES=5
AUTO_ROLE_FIT=true
ALLOW_SIGNUP=true
SIGNUP_MAX_PER_HOUR=20
DEFAULT_MONTHLY_TOKEN_BUDGET=500000
RATE_LIMIT_PER_MINUTE=60
